worker_processes 1;
pid /tmp/skillbattles-nginx.pid;
# Upstream error messages can echo full request URLs containing reset tokens.
error_log /dev/null crit;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    types { application/javascript mjs; application/wasm wasm; }
    default_type application/octet-stream;
    # Never log query strings (password reset tokens) or authorization headers.
    log_format safe '$request_method $uri $status $body_bytes_sent';
    access_log /dev/stdout safe;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 10m;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    # TLS terminates at Heroku's router, which supplies X-Forwarded-Proto.
    map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; http http; }
    server {
        listen ${PORT};
        server_name _;
        root /app/web;
        server_tokens off;
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_types application/javascript application/json application/wasm text/css image/svg+xml;
        add_header_inherit merge;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Port "";
        # Preserve all reserved backend namespaces, JSON errors and JWT checks.
        location ~ ^/(api|ws|media|v3|swagger-ui|error)(/|\.|$) {
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_pass http://127.0.0.1:8081;
        }
        location ~ ^/(assets|vendor|styles|icons)(/|$)|\.[^/]+$ {
            add_header Cache-Control no-cache always;
            try_files $uri =404;
        }
        location = / {
            add_header Cache-Control no-store always;
            proxy_pass http://127.0.0.1:3000;
        }
        location / {
            add_header Cache-Control no-store always;
            try_files $uri @jaspr;
        }
        location @jaspr {
            add_header Cache-Control no-store always;
            proxy_pass http://127.0.0.1:3000;
        }
    }
}
