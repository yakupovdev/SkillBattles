# Copy to .env and replace both empty values locally; never commit real secrets.
POSTGRES_DB=skillbattles
POSTGRES_USER=skillbattles
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
# Base64 of at least 32 cryptographically random bytes (see backend/README.md).
JWT_SECRET=
JWT_ISSUER=skillbattles
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
# Optional Stripe TEST settings: backend/.env.billing.example (keep real values local).
