# Copy once to ROOT .env. All launch/configuration scripts use that file only.
# No production credentials. Unquoted ${NAME} references are expanded as data.
# Use single quotes for literal values containing $, # or spaces; never shell code.
COMPOSE_PROJECT_NAME=skillbattles-local
POSTGRES_DB=skillbattles_v03
POSTGRES_USER=skillbattles
# Generate a random password locally; do not change it for an existing volume.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
BACKEND_PORT=8080
FRONTEND_PORT=8081
SERVER_PORT=${BACKEND_PORT}
# Host JVM connection. Compose overrides the hostname/port with postgres:5432.
DB_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
# Base64 of at least 32 cryptographically random bytes. Never print the value.
JWT_SECRET=
JWT_ISSUER=skillbattles
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# Hosted Checkout needs no frontend publishable key. Never expose server ENV to a bundler.
# Get a test/restricted test key from the SAME Stripe sandbox as the Prices/listener.
BILLING_MODE=TEST
STRIPE_SECRET_KEY=
# Filled by Start-StripeListener.ps1 from the real listener, never invented.
STRIPE_WEBHOOK_SECRET=
# Recurring USD 799 cents/month ($7.99) and 4799 cents/year ($47.99).
# Initialize-StripeTest.ps1 reuses matching Prices before creating anything.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Trusted frontend routes; the root Compose publishes FRONTEND_PORT.
BILLING_SUCCESS_URL=http://localhost:${FRONTEND_PORT}/billing/return?success=true
BILLING_CANCEL_URL=http://localhost:${FRONTEND_PORT}/billing/return?success=false
BILLING_PORTAL_RETURN_URL=http://localhost:${FRONTEND_PORT}/billing/return

# Existing application settings.
SEASON_SCAN_MS=60000
SEASON_SCHEDULING_ENABLED=true
MATCHMAKING_SEARCH_SECONDS=90
PRIVATE_DUEL_SECONDS=600
READY_TIMEOUT_SECONDS=30
COUNTDOWN_SECONDS=3
REVEAL_SECONDS=5
RECONNECT_GRACE_SECONDS=30
QUESTION_HISTORY_BATTLES=5

# SMTP reset delivery. Leave SMTP_HOST empty until a provider or local Mailpit is configured.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=
# Trusted frontend route, no query or fragment. Set before enabling reset delivery.
PASSWORD_RESET_BASE_URL=http://localhost:${FRONTEND_PORT}/auth/reset
PASSWORD_RESET_TTL=PT20M
