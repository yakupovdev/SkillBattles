FROM ubuntu:24.04 AS flutter-sdk
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip xz-utils libglu1-mesa libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
# Matches pubspec SDK ^3.14.0 and the committed lockfile; no floating latest.
ARG FLUTTER_VERSION=3.50.0
ARG FLUTTER_SHA256=6ea2d806fd57269ae783e6788e2a81fc26eaad782f1e0d0ff38623bb765ff9f5
ENV FLUTTER_ROOT=/opt/flutter PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:$PATH CI=true FLUTTER_SUPPRESS_ANALYTICS=true DART_SUPPRESS_ANALYTICS=true
RUN curl -fsSL --retry 3 "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" -o /tmp/flutter.tar.xz \
    && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/flutter.tar.xz -C /opt && rm /tmp/flutter.tar.xz \
    && git config --global --add safe.directory /opt/flutter \
    && flutter config --no-analytics --enable-web && flutter precache --web

FROM flutter-sdk AS frontend-source
WORKDIR /app
COPY frontend/pubspec.yaml frontend/pubspec.lock ./
RUN flutter pub get --enforce-lockfile
COPY frontend/ ./

FROM frontend-source AS frontend-build
RUN flutter build web --release --wasm --no-pub --no-web-resources-cdn \
    --dart-define=DEV_MOCKS=false --dart-define=API_BASE_URL=/api/v1 \
    --dart-define=EVENTS_URL=/ws/v1/events --dart-define=MEDIA_ORIGIN=

FROM eclipse-temurin:21-jdk-alpine AS backend-build
WORKDIR /app
COPY backend/.mvn .mvn
COPY backend/mvnw backend/pom.xml ./
RUN chmod +x mvnw
COPY backend/src src
COPY --from=frontend-build /app/build/web/ src/main/resources/static/
# Plain RUN: also works with Heroku's remote Docker builder, no cache mounts.
RUN ./mvnw -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=backend-build --chown=app:app /app/target/backend-0.0.1-SNAPSHOT.jar app.jar
USER app
ENV TZ=UTC SPRING_PROFILES_ACTIVE=heroku
# 224 MiB heap leaves room inside 512 MiB for metaspace, code, threads and buffers.
# Exec-form CMD delivers SIGTERM to Java; no shell parent or second server.
CMD ["java", "-Xms64m", "-Xmx224m", "-Xss512k", "-XX:MaxMetaspaceSize=128m", "-XX:ReservedCodeCacheSize=48m", "-XX:MaxDirectMemorySize=32m", "-XX:ActiveProcessorCount=2", "-XX:+ExitOnOutOfMemoryError", "-Duser.timezone=UTC", "-jar", "app.jar"]
