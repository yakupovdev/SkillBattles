# Match frontend/Dockerfile and the committed Dart <3.14 lockfile.
FROM dart:3.13.7 AS frontend-source
WORKDIR /app
RUN dart pub global activate jaspr_cli 0.23.5
ENV PATH=/root/.pub-cache/bin:$PATH
COPY frontend/pubspec.yaml frontend/pubspec.lock ./
RUN dart pub get --enforce-lockfile
COPY frontend/ ./

FROM frontend-source AS frontend-build
RUN jaspr build --dart-define=API_BASE_URL=/api/v1 \
    --dart-define=EVENTS_URL=/ws/v1/events

FROM eclipse-temurin:21-jdk-alpine AS backend-build
WORKDIR /app
COPY backend/.mvn .mvn
COPY backend/mvnw backend/pom.xml ./
RUN chmod +x mvnw
COPY backend/src src
RUN ./mvnw -B -ntp -DskipTests package

# Both Java and the compiled Jaspr executable require a glibc runtime.
FROM eclipse-temurin:21-jre-noble AS java-runtime
FROM nginx:1.30.0 AS runtime
COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH \
    TZ=UTC SPRING_PROFILES_ACTIVE=heroku
WORKDIR /app
RUN useradd --uid 10001 --create-home app
COPY --from=backend-build /app/target/backend-0.0.1-SNAPSHOT.jar /app/app.jar
COPY --from=frontend-build /app/build/jaspr/app /app/app
COPY --from=frontend-build /app/build/jaspr/web /app/web
COPY backend/deploy/heroku/nginx.conf.template /app/nginx.conf.template
COPY backend/deploy/heroku/start.sh /app/start.sh
RUN chmod +x /app/start.sh /app/app
USER app
STOPSIGNAL SIGTERM
# The supervisor forwards termination and stops the dyno if any child fails.
ENTRYPOINT ["/app/start.sh"]
CMD []
